          "range": "PfControl",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_principle_implementations",
          "description": "How the organization stands against each privacy principle.",
          "range": "PfPrincipleImplementation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_risks",
          "description": "The risks to people that the organization has identified.",
          "range": "PfRisk",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_impact_assessments",
