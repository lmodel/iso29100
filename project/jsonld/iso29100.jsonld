    {
      "name": "PfBreach",
      "definition_uri": "https://w3id.org/lmodel/iso29100/PfBreach",
      "description": "A time when PII was handled against a safeguarding requirement: what happened, who was told and what was done.",
      "comments": [
        "The framework names the idea of a breach. These fields are what an adopter keeps, and go beyond the framework itself."
      ],
      "from_schema": "https://w3id.org/lmodel/iso29100",
      "mixins": [
        "PfRecordMixin"
      ],
      "slots": [
        "pf_concerned_pii",
        "pfBreach__pf_breach_occurred",
        "pfBreach__pf_breach_discovered",
        "pfBreach__pf_breach_closed",
        "pfBreach__pf_principals_affected",
        "pfBreach__pf_breached_requirements",
        "pfBreach__pf_breach_severity",
        "pfBreach__pf_immediate_actions",
        "pfBreach__pf_notification_required",
        "pfBreach__pf_notifications",
        "pfBreach__pf_remediation",
        "pfBreach__pf_lessons",
        "pf_id",
        "PfRecordMixin_title",
        "description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "pf_breach_occurred",
          "description": "When the breach happened.",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_breach_discovered",
          "description": "When the organization found out, which is not before it happened.",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_breach_closed",
          "description": "When the organization closed the matter, which is not before it found out.",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_principals_affected",
          "description": "How many people the breach reached, where that is known.",
          "range": "integer",
          "minimum_value": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_breached_requirements",
          "description": "The safeguarding requirements the breach went against.",
          "range": "PfSafeguardingRequirement",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_breach_severity",
          "description": "How serious the breach is.",
          "range": "PfRiskLevel",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_immediate_actions",
          "description": "What was done straight away.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_notification_required",
          "description": "Whether a law or contract requires anyone to be told.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_notifications",
          "description": "Who was told, and when.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_remediation",
          "description": "What was done to put things right.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_lessons",
          "description": "What the organization learned.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/iso29100/PfBreach",
      "@type": "ClassDefinition"
    },
    {
      "name": "PfConsent",
      "definition_uri": "https://w3id.org/lmodel/iso29100/PfConsent",
      "description": "One person's agreement to the processing of their PII for stated purposes, and where it stands.",
      "comments": [
        "The framework defines consent and its principle, and DPV maps that term to dpv:InformedConsent. The fields are what an adopter keeps, and go beyond the framework itself."
      ],
      "from_schema": "https://w3id.org/lmodel/iso29100",
      "exact_mappings": [
        "dpv:InformedConsent"
      ],
      "mixins": [
        "PfRecordMixin"
      ],
      "slots": [
        "pf_purposes",
        "pf_concerned_pii",
        "pf_evidence",
        "PfConsent_pf_principal",
        "pfConsent__pf_consent_mechanism",
        "pfConsent__pf_consent_given",
        "pfConsent__pf_consent_state",
        "pfConsent__pf_consent_withdrawn",
        "pf_id",
        "PfRecordMixin_title",
        "description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "pf_consent_mechanism",
          "description": "How the agreement was obtained.",
          "range": "PfConsentMechanism",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_consent_given",
          "description": "When the person agreed.",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_consent_state",
          "description": "Where the agreement stands.",
          "range": "PfConsentState",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_consent_withdrawn",
          "description": "When the person took the agreement back.",
          "range": "datetime",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/iso29100/PfConsent",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "pf_consent_withdrawn",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "pf_consent_state",
                "equals_string": "withdrawn",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A consent with a withdrawal date has the state withdrawn.",
          "title": "a withdrawal date means the consent is withdrawn",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PfPreference",
      "definition_uri": "https://w3id.org/lmodel/iso29100/PfPreference",
      "description": "What one person has said they want done, or not done, with their PII.",
      "comments": [
        "The framework names the idea of a privacy preference. These fields are what an adopter keeps, and go beyond the framework itself."
      ],
      "from_schema": "https://w3id.org/lmodel/iso29100",
      "mixins": [
        "PfRecordMixin"
      ],
      "slots": [
        "PfPreference_pf_principal",
        "pfPreference__pf_preference_scope",
        "pfPreference__pf_wants_anonymity",
        "pfPreference__pf_wants_pseudonymity",
        "pfPreference__pf_refused_operations",
        "pfPreference__pf_refused_recipients",
        "pfPreference__pf_preference_recorded",
        "pf_id",
        "PfRecordMixin_title",
        "description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "pf_preference_scope",
          "description": "What the preference applies to.",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_wants_anonymity",
          "description": "Whether the person asks not to be identified at all.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_wants_pseudonymity",
          "description": "Whether the person asks to appear under an alias.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_refused_operations",
          "description": "What the person does not want done to their PII.",
          "range": "PfOperation",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_refused_recipients",
          "description": "Who the person does not want their PII passed to.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_preference_recorded",
          "description": "When the organization recorded the preference.",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/iso29100/PfPreference",
      "@type": "ClassDefinition"
    }
