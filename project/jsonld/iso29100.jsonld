          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_consents",
          "description": "The consents the organization holds.",
          "range": "PfConsent",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pf_preferences",
          "description": "What people have said they prefer.",
          "range": "PfPreference",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
