	rdfs:label "pf_pii_categories" ;
	skos:definition "What the item holds, in the organization's own words." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_pii_items a owl:ObjectProperty ;
	rdfs:label "pf_pii_items" ;
