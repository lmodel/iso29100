@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iso29100: <https://w3id.org/lmodel/iso29100/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix pav: <http://purl.org/pav/> .
xsd:duration a rdfs:Datatype ;
	owl:equivalentClass _:c14n51 .
<https://w3id.org/lmodel/iso29100.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://www.iso.org/standard/85938.html> ;
	dcterms:title "ISO/IEC 29100:2024 privacy framework records" ;
	pav:version "2024" ;
	a owl:Ontology ;
	rdfs:label "iso29100" ;
	rdfs:seeAlso <https://lmodel.github.io/iso29100> , <https://www.iso.org/standard/85938.html> ;
	skos:definition "A LinkML model of the records an organization keeps when it applies the privacy framework of ISO/IEC 29100:2024 to the information and communication technology (ICT) systems that handle personally identifiable information (PII). The records say who takes part, which PII is involved and how it moves, what must be safeguarded and how, and how the organization stands against each privacy principle." ;
	skos:note "Every record that other records refer to has a pf_id, and a reference holds that identifier. PfFramework holds each kind of record in a list of its own." , "ISO/IEC 29100 is copyright ISO and IEC, and none of its text is reproduced here. An element's title and description are this project's own words. An element cites what it models by number in the iso29100_clause annotation only where a third party's public outline of the edition gives that number, so terms and lower subclauses go uncited. A reader with a licensed copy looks the text up there." , "The mappings to the Data Privacy Vocabulary (DPV) are the five rows DPV publishes for this edition, in upstream/dpv-iso.ttl, with DPV's direction kept. No other mapping is declared, because no source states one." , "The version is the edition the schema models, and source is ISO's page for it. ISO Open Data's records of the edition and of the two it replaced are copied to src/iso29100/schema/iso-open-data/ on the date the annotations give, and scripts/check_upstream_release.py reports when ISO changes them. The release tags are the schema's own versions." ;
	iso29100:edition "2" ;
	iso29100:iso_open_data_date "2026-11-05" ;
	iso29100:publication_date "2024-02-16" ;
	iso29100:replaces "ISO/IEC 29100:2011, ISO/IEC 29100:2011/Amd 1:2018" ;
	iso29100:standard "ISO/IEC 29100:2024" .
iso29100:PfActor a owl:Class ;
	rdfs:label "PfActor" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n149 , _:c14n150 , _:c14n267 , _:c14n307 , _:c14n331 , _:c14n409 , _:c14n44 , _:c14n64 , _:c14n69 ;
	skos:definition "Someone who takes part in handling PII, told apart by the part they play. One party can play different parts for different PII, with a record for each." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.2" .
iso29100:PfBreach a owl:Class ;
	rdfs:label "PfBreach" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n10 , _:c14n101 , _:c14n117 , _:c14n170 , _:c14n184 , _:c14n192 , _:c14n209 , _:c14n25 , _:c14n26 , _:c14n263 , _:c14n282 , _:c14n296 , _:c14n299 , _:c14n306 , _:c14n316 , _:c14n329 , _:c14n346 , _:c14n354 , _:c14n355 , _:c14n358 , _:c14n359 , _:c14n377 , _:c14n378 , _:c14n382 , _:c14n389 , _:c14n399 , _:c14n43 , _:c14n59 , _:c14n78 , _:c14n87 , _:c14n9 ;
	skos:definition "A time when PII was handled against a safeguarding requirement: what happened, who was told and what was done." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "The framework names the idea of a breach. These fields are what an adopter keeps, and go beyond the framework itself." .
iso29100:PfConsent a owl:Class ;
	rdfs:label "PfConsent" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n110 , _:c14n112 , _:c14n118 , _:c14n13 , _:c14n163 , _:c14n179 , _:c14n186 , _:c14n202 , _:c14n208 , _:c14n210 , _:c14n23 , _:c14n232 , _:c14n240 , _:c14n258 , _:c14n325 , _:c14n344 , _:c14n352 , _:c14n36 , _:c14n53 , _:c14n96 , _:c14n99 ;
	skos:definition "One person's agreement to the processing of their PII for stated purposes, and where it stands." ;
	skos:exactMatch dpv:InformedConsent ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "The framework defines consent and its principle, and DPV maps that term to dpv:InformedConsent. The fields are what an adopter keeps, and go beyond the framework itself." .
iso29100:PfConsentMechanism\#implied a owl:Class ;
	rdfs:label "implied" ;
	rdfs:subClassOf iso29100:PfConsentMechanism ;
	skos:definition "Something the person does shows agreement, such as placing an order, where the law allows that reading." .
iso29100:PfConsentMechanism\#opt_in a owl:Class ;
	rdfs:label "opt_in" ;
	rdfs:subClassOf iso29100:PfConsentMechanism ;
	skos:definition "The person acts to agree before the processing starts." .
iso29100:PfConsentMechanism\#opt_out a owl:Class ;
	rdfs:label "opt_out" ;
	rdfs:subClassOf iso29100:PfConsentMechanism ;
	skos:definition "The processing goes ahead unless the person acts to refuse it." .
iso29100:PfConsentMechanism a owl:Class ;
	rdfs:label "PfConsentMechanism" ;
	owl:unionOf _:c14n256 ;
	skos:definition "How a person's agreement to processing is obtained." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfConsentMechanism\#implied , iso29100:PfConsentMechanism\#opt_in , iso29100:PfConsentMechanism\#opt_out .
iso29100:PfConsentState\#expired a owl:Class ;
	rdfs:label "expired" ;
	rdfs:subClassOf iso29100:PfConsentState ;
	skos:definition "The agreement ran out." .
iso29100:PfConsentState\#given a owl:Class ;
	rdfs:label "given" ;
	rdfs:subClassOf iso29100:PfConsentState ;
	skos:definition "The agreement holds." .
iso29100:PfConsentState\#refused a owl:Class ;
	rdfs:label "refused" ;
	rdfs:subClassOf iso29100:PfConsentState ;
	skos:definition "The person said no." .
iso29100:PfConsentState\#withdrawn a owl:Class ;
	rdfs:label "withdrawn" ;
	rdfs:subClassOf iso29100:PfConsentState ;
	skos:definition "The person took back an agreement they had given." .
iso29100:PfConsentState a owl:Class ;
	rdfs:label "PfConsentState" ;
	owl:unionOf _:c14n272 ;
	skos:definition "Where a person's agreement stands." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfConsentState\#expired , iso29100:PfConsentState\#given , iso29100:PfConsentState\#refused , iso29100:PfConsentState\#withdrawn .
iso29100:PfControl a owl:Class ;
	rdfs:label "PfControl" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n0 , _:c14n107 , _:c14n123 , _:c14n124 , _:c14n126 , _:c14n141 , _:c14n189 , _:c14n236 , _:c14n255 , _:c14n268 , _:c14n273 , _:c14n281 , _:c14n286 , _:c14n287 , _:c14n348 , _:c14n362 , _:c14n404 , _:c14n45 , _:c14n66 , _:c14n70 , _:c14n94 ;
	skos:definition "A measure that treats a privacy risk by making it less likely or less harmful, the principles it serves and how far it has been put into effect." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.7" .
iso29100:PfControlKind\#contractual a owl:Class ;
	rdfs:label "contractual" ;
	rdfs:subClassOf iso29100:PfControlKind ;
	skos:definition "A binding agreement, such as one with a processor or across a group of companies." .
iso29100:PfControlKind\#organizational a owl:Class ;
	rdfs:label "organizational" ;
	rdfs:subClassOf iso29100:PfControlKind ;
	skos:definition "A policy, a procedure, a role or another way of running things." .
iso29100:PfControlKind\#physical a owl:Class ;
	rdfs:label "physical" ;
	rdfs:subClassOf iso29100:PfControlKind ;
	skos:definition "A measure that guards the places and equipment where PII sits." .
iso29100:PfControlKind\#privacy_enhancing_technology a owl:Class ;
	rdfs:label "privacy_enhancing_technology" ;
	rdfs:subClassOf iso29100:PfControlKind ;
	skos:definition "A technical measure built to reduce what is collected or revealed about people." .
iso29100:PfControlKind\#technical a owl:Class ;
	rdfs:label "technical" ;
	rdfs:subClassOf iso29100:PfControlKind ;
	skos:definition "A system, product or service that protects PII." .
iso29100:PfControlKind a owl:Class ;
	rdfs:label "PfControlKind" ;
	owl:unionOf _:c14n104 ;
	skos:definition "The form a control takes." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfControlKind\#contractual , iso29100:PfControlKind\#organizational , iso29100:PfControlKind\#physical , iso29100:PfControlKind\#privacy_enhancing_technology , iso29100:PfControlKind\#technical ;
	iso29100:iso29100_clause "5.7" .
iso29100:PfFramework a owl:Class ;
	rdfs:label "PfFramework" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n105 , _:c14n122 , _:c14n135 , _:c14n145 , _:c14n153 , _:c14n16 , _:c14n168 , _:c14n195 , _:c14n2 , _:c14n200 , _:c14n212 , _:c14n219 , _:c14n222 , _:c14n243 , _:c14n246 , _:c14n261 , _:c14n269 , _:c14n288 , _:c14n290 , _:c14n297 , _:c14n322 , _:c14n330 , _:c14n349 , _:c14n353 , _:c14n369 , _:c14n373 , _:c14n380 , _:c14n391 , _:c14n401 , _:c14n65 , _:c14n67 , _:c14n73 , _:c14n92 ;
	skos:definition "One organization's use of the privacy framework: the systems it covers, and every record the organization keeps about them, each kind in a list of its own." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.1" .
iso29100:PfImpactAssessment a owl:Class ;
	rdfs:label "PfImpactAssessment" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n138 , _:c14n147 , _:c14n148 , _:c14n166 , _:c14n197 , _:c14n21 , _:c14n224 , _:c14n225 , _:c14n251 , _:c14n260 , _:c14n27 , _:c14n29 , _:c14n293 , _:c14n294 , _:c14n3 , _:c14n320 , _:c14n336 , _:c14n341 , _:c14n360 , _:c14n371 , _:c14n379 , _:c14n38 , _:c14n392 , _:c14n396 , _:c14n402 ;
	skos:definition "A review of what a system or activity could do to people's privacy, the risks it found and what became of them." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "These fields are what an adopter keeps, and go beyond the framework itself." .
iso29100:PfImplementationState\#in_operation a owl:Class ;
	rdfs:label "in_operation" ;
	rdfs:subClassOf iso29100:PfImplementationState ;
	skos:definition "It is in place and working." .
iso29100:PfImplementationState\#in_progress a owl:Class ;
	rdfs:label "in_progress" ;
	rdfs:subClassOf iso29100:PfImplementationState ;
	skos:definition "It is being put in place." .
iso29100:PfImplementationState\#planned a owl:Class ;
	rdfs:label "planned" ;
	rdfs:subClassOf iso29100:PfImplementationState ;
	skos:definition "It is decided on but not started." .
iso29100:PfImplementationState\#retired a owl:Class ;
	rdfs:label "retired" ;
	rdfs:subClassOf iso29100:PfImplementationState ;
	skos:definition "It is no longer in use." .
iso29100:PfImplementationState a owl:Class ;
	rdfs:label "PfImplementationState" ;
	owl:unionOf _:c14n220 ;
	skos:definition "How far a control has been put into effect." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfImplementationState\#in_operation , iso29100:PfImplementationState\#in_progress , iso29100:PfImplementationState\#planned , iso29100:PfImplementationState\#retired .
iso29100:PfOperation\#alter a owl:Class ;
	rdfs:label "alter" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Change PII that is already held." .
iso29100:PfOperation\#anonymize a owl:Class ;
	rdfs:label "anonymize" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Change PII so that nobody can trace it back to a person again." .
iso29100:PfOperation\#collect a owl:Class ;
	rdfs:label "collect" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Get PII from the person it is about, or from another source." .
iso29100:PfOperation\#consult a owl:Class ;
	rdfs:label "consult" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Look at PII without taking a copy away." .
iso29100:PfOperation\#delete a owl:Class ;
	rdfs:label "delete" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Remove PII so that it can no longer be reached or used." .
iso29100:PfOperation\#destroy a owl:Class ;
	rdfs:label "destroy" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Remove PII and whatever carried it, beyond recovery." .
iso29100:PfOperation\#disclose a owl:Class ;
	rdfs:label "disclose" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Make PII available to another party." .
iso29100:PfOperation\#disseminate a owl:Class ;
	rdfs:label "disseminate" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Spread PII widely, such as by publishing it." .
iso29100:PfOperation\#pseudonymize a owl:Class ;
	rdfs:label "pseudonymize" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Swap identifying details for an alias, in a way someone can still trace back." .
iso29100:PfOperation\#retrieve a owl:Class ;
	rdfs:label "retrieve" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Fetch stored PII for use." .
iso29100:PfOperation\#store a owl:Class ;
	rdfs:label "store" ;
	rdfs:subClassOf iso29100:PfOperation ;
	skos:definition "Hold PII on a lasting medium." .
iso29100:PfOperation a owl:Class ;
	rdfs:label "PfOperation" ;
	owl:unionOf _:c14n410 ;
	skos:definition "The things an organization can do to PII." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfOperation\#alter , iso29100:PfOperation\#anonymize , iso29100:PfOperation\#collect , iso29100:PfOperation\#consult , iso29100:PfOperation\#delete , iso29100:PfOperation\#destroy , iso29100:PfOperation\#disclose , iso29100:PfOperation\#disseminate , iso29100:PfOperation\#pseudonymize , iso29100:PfOperation\#retrieve , iso29100:PfOperation\#store .
iso29100:PfPiiController a owl:Class ;
	rdfs:label "PfPiiController" ;
	rdfs:subClassOf iso29100:PfActor , _:c14n164 , _:c14n172 , _:c14n182 , _:c14n207 , _:c14n214 , _:c14n22 , _:c14n237 , _:c14n303 , _:c14n327 , _:c14n338 , _:c14n387 , _:c14n398 ;
	skos:definition "The party that decides why and how PII is processed, and answers for it even when another party does the work." ;
	skos:exactMatch dpv:DataController ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.2" .
iso29100:PfPiiFlow a owl:Class ;
	rdfs:label "PfPiiFlow" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n137 , _:c14n139 , _:c14n15 , _:c14n188 , _:c14n196 , _:c14n271 , _:c14n333 , _:c14n343 , _:c14n405 , _:c14n54 , _:c14n86 ;
	skos:definition "One way PII passes from one actor to another, and who decides what happens to it afterwards." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.3" .
iso29100:PfPiiItem a owl:Class ;
	rdfs:label "PfPiiItem" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n115 , _:c14n162 , _:c14n167 , _:c14n178 , _:c14n235 , _:c14n248 , _:c14n249 , _:c14n295 , _:c14n366 , _:c14n37 , _:c14n4 , _:c14n403 , _:c14n407 , _:c14n41 , _:c14n55 , _:c14n56 , _:c14n60 , _:c14n7 , _:c14n75 , _:c14n89 ;
	skos:definition "A piece or set of information that can be tied to a person, why it counts as PII, how sensitive it is and how it is handled." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:narrowMatch dpv:PersonalData ;
	skos:note "DPV's mapping says dpv:PersonalData is narrower than the standard's PII, and this class keeps that direction." ;
	iso29100:iso29100_clause "5.4" .
iso29100:PfPiiPrincipal a owl:Class ;
	rdfs:label "PfPiiPrincipal" ;
	rdfs:subClassOf iso29100:PfActor ;
	skos:definition "The person the PII is about, or a group of such people when the organization records them together." ;
	skos:exactMatch dpv:DataSubject ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.2" .
iso29100:PfPiiProcessor a owl:Class ;
	rdfs:label "PfPiiProcessor" ;
	rdfs:subClassOf iso29100:PfActor , _:c14n171 , _:c14n206 , _:c14n226 , _:c14n277 , _:c14n351 , _:c14n6 , _:c14n84 ;
	skos:definition "A party that processes PII for a controller, on that controller's instructions." ;
	skos:exactMatch dpv:DataProcessor ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.2" .
iso29100:PfPiiRecognition\#direct_identifier a owl:Class ;
	rdfs:label "direct_identifier" ;
	rdfs:subClassOf iso29100:PfPiiRecognition ;
	skos:definition "It singles out one person by itself, such as a passport number." .
iso29100:PfPiiRecognition\#distinguishing_trait a owl:Class ;
	rdfs:label "distinguishing_trait" ;
	rdfs:subClassOf iso29100:PfPiiRecognition ;
	skos:definition "It sets one person apart, alone or with other details, such as a rare job title in a small town." .
iso29100:PfPiiRecognition\#linked_information a owl:Class ;
	rdfs:label "linked_information" ;
	rdfs:subClassOf iso29100:PfPiiRecognition ;
	skos:definition "It says something about a person who is already known, or can be joined to a record that does." .
iso29100:PfPiiRecognition\#metadata a owl:Class ;
	rdfs:label "metadata" ;
	rdfs:subClassOf iso29100:PfPiiRecognition ;
	skos:definition "It describes other data, such as a message's sender and time, and so reveals a person." .
iso29100:PfPiiRecognition\#pseudonym a owl:Class ;
	rdfs:label "pseudonym" ;
	rdfs:subClassOf iso29100:PfPiiRecognition ;
	skos:definition "It holds an alias in place of an identifier, and the alias can be traced." .
iso29100:PfPiiRecognition\#unsolicited a owl:Class ;
	rdfs:label "unsolicited" ;
	rdfs:subClassOf iso29100:PfPiiRecognition ;
	skos:definition "The organization received it without asking for it." .
iso29100:PfPiiRecognition a owl:Class ;
	rdfs:label "PfPiiRecognition" ;
	owl:unionOf _:c14n109 ;
	skos:definition "The ways information turns out to be PII, which a record lists so that a reader can see why the item counts." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfPiiRecognition\#direct_identifier , iso29100:PfPiiRecognition\#distinguishing_trait , iso29100:PfPiiRecognition\#linked_information , iso29100:PfPiiRecognition\#metadata , iso29100:PfPiiRecognition\#pseudonym , iso29100:PfPiiRecognition\#unsolicited ;
	iso29100:iso29100_clause "5.4" .
iso29100:PfPolicy a owl:Class ;
	rdfs:label "PfPolicy" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n108 , _:c14n127 , _:c14n129 , _:c14n157 , _:c14n176 , _:c14n18 , _:c14n181 , _:c14n223 , _:c14n228 , _:c14n242 , _:c14n244 , _:c14n275 , _:c14n280 , _:c14n309 , _:c14n312 , _:c14n313 , _:c14n315 , _:c14n317 , _:c14n335 , _:c14n339 , _:c14n356 , _:c14n375 , _:c14n393 , _:c14n47 , _:c14n62 , _:c14n76 , _:c14n81 , _:c14n85 , _:c14n88 ;
	skos:definition "A privacy policy: what the organization commits to about PII, written for its own people or as a notice to the people whose PII it handles." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.6" .
iso29100:PfPolicyAudience\#internal a owl:Class ;
	rdfs:label "internal" ;
	rdfs:subClassOf iso29100:PfPolicyAudience ;
	skos:definition "People inside the organization, who act on its commitments." .
iso29100:PfPolicyAudience\#public_notice a owl:Class ;
	rdfs:label "public_notice" ;
	rdfs:subClassOf iso29100:PfPolicyAudience ;
	skos:definition "The people whose PII it handles, who read it to learn what happens." .
iso29100:PfPolicyAudience a owl:Class ;
	rdfs:label "PfPolicyAudience" ;
	owl:unionOf _:c14n128 ;
	skos:definition "Who a privacy policy is written for." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfPolicyAudience\#internal , iso29100:PfPolicyAudience\#public_notice ;
	iso29100:iso29100_clause "5.6" .
iso29100:PfPreference a owl:Class ;
	rdfs:label "PfPreference" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n158 , _:c14n17 , _:c14n193 , _:c14n199 , _:c14n211 , _:c14n217 , _:c14n233 , _:c14n238 , _:c14n259 , _:c14n289 , _:c14n300 , _:c14n310 , _:c14n345 , _:c14n35 , _:c14n394 , _:c14n395 , _:c14n57 , _:c14n8 , _:c14n83 ;
	skos:definition "What one person has said they want done, or not done, with their PII." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "The framework names the idea of a privacy preference. These fields are what an adopter keeps, and go beyond the framework itself." .
iso29100:PfPrinciple\#principle_6_10 dcterms:title "6.10 Answer for it" ;
	a owl:Class ;
	rdfs:label "principle_6_10" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "The organization writes down its duties, keeps protection in place when PII passes to others, and handles complaints and redress." ;
	iso29100:iso29100_clause "6.10" .
iso29100:PfPrinciple\#principle_6_11 dcterms:title "6.11 Keep it safe" ;
	a owl:Class ;
	rdfs:label "principle_6_11" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "Security measures at every level guard PII against loss and unauthorized reach for as long as it is held." ;
	iso29100:iso29100_clause "6.11" .
iso29100:PfPrinciple\#principle_6_12 dcterms:title "6.12 Show the rules are met" ;
	a owl:Class ;
	rdfs:label "principle_6_12" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "The organization checks, and can prove, that it meets its privacy duties, through audits and regular risk assessment." ;
	iso29100:iso29100_clause "6.12" .
iso29100:PfPrinciple\#principle_6_2 dcterms:title "6.2 People decide" ;
	a owl:Class ;
	rdfs:label "principle_6_2" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "People get a say in whether their PII is processed, can agree or refuse purpose by purpose, and can change their minds later." ;
	iso29100:iso29100_clause "6.2" .
iso29100:PfPrinciple\#principle_6_3 dcterms:title "6.3 Lawful, stated reasons" ;
	a owl:Class ;
	rdfs:label "principle_6_3" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "The law allows each reason for processing, and people are told the reason before their PII is gathered, or at that moment." ;
	iso29100:iso29100_clause "6.3" .
iso29100:PfPrinciple\#principle_6_4 dcterms:title "6.4 Gather within bounds" ;
	a owl:Class ;
	rdfs:label "principle_6_4" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "The organization gathers only the PII that the law allows and its stated reasons need." ;
	iso29100:iso29100_clause "6.4" .
iso29100:PfPrinciple\#principle_6_5 dcterms:title "6.5 A small footprint" ;
	a owl:Class ;
	rdfs:label "principle_6_5" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "Systems and procedures are built to touch as little PII as they can, and as few people as possible can reach it." ;
	iso29100:iso29100_clause "6.5" .
iso29100:PfPrinciple\#principle_6_6 dcterms:title "6.6 Bounded use and keeping" ;
	a owl:Class ;
	rdfs:label "principle_6_6" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "PII is used, shared and kept only as far as the stated reasons go, and is safely disposed of afterwards." ;
	iso29100:iso29100_clause "6.6" .
iso29100:PfPrinciple\#principle_6_7 dcterms:title "6.7 Correct and fit" ;
	a owl:Class ;
	rdfs:label "principle_6_7" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "PII stays right, whole, up to date and suited to its use, and there are ways to check and fix it." ;
	iso29100:iso29100_clause "6.7" .
iso29100:PfPrinciple\#principle_6_8 dcterms:title "6.8 Say what happens" ;
	a owl:Class ;
	rdfs:label "principle_6_8" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "People can easily find out what the organization does with PII, and hear about important changes." ;
	iso29100:iso29100_clause "6.8" .
iso29100:PfPrinciple\#principle_6_9 dcterms:title "6.9 People see their own" ;
	a owl:Class ;
	rdfs:label "principle_6_9" ;
	rdfs:subClassOf iso29100:PfPrinciple ;
	skos:definition "People can look at the PII held about them and dispute it, within what the law allows." ;
	iso29100:iso29100_clause "6.9" .
iso29100:PfPrinciple a owl:Class ;
	rdfs:label "PfPrinciple" ;
	owl:unionOf _:c14n187 ;
	skos:definition "The privacy principles by their subclause numbers. A value's title and description are this project's own summary, and the principles' headings and wording are ISO's." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfPrinciple\#principle_6_10 , iso29100:PfPrinciple\#principle_6_11 , iso29100:PfPrinciple\#principle_6_12 , iso29100:PfPrinciple\#principle_6_2 , iso29100:PfPrinciple\#principle_6_3 , iso29100:PfPrinciple\#principle_6_4 , iso29100:PfPrinciple\#principle_6_5 , iso29100:PfPrinciple\#principle_6_6 , iso29100:PfPrinciple\#principle_6_7 , iso29100:PfPrinciple\#principle_6_8 , iso29100:PfPrinciple\#principle_6_9 ;
	iso29100:iso29100_clause "6.1" .
iso29100:PfPrincipleImplementation a owl:Class ;
	rdfs:label "PfPrincipleImplementation" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n114 , _:c14n159 , _:c14n161 , _:c14n165 , _:c14n174 , _:c14n203 , _:c14n215 , _:c14n250 , _:c14n266 , _:c14n276 , _:c14n334 , _:c14n365 , _:c14n367 , _:c14n384 , _:c14n40 , _:c14n71 ;
	skos:definition "How the organization stands against one privacy principle: what it does, what shows it, and what is still missing." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "6.1" .
iso29100:PfProcessingActivity a owl:Class ;
	rdfs:label "PfProcessingActivity" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n11 , _:c14n119 , _:c14n120 , _:c14n125 , _:c14n132 , _:c14n142 , _:c14n177 , _:c14n185 , _:c14n190 , _:c14n194 , _:c14n20 , _:c14n204 , _:c14n213 , _:c14n239 , _:c14n252 , _:c14n302 , _:c14n305 , _:c14n31 , _:c14n32 , _:c14n323 , _:c14n328 , _:c14n368 , _:c14n372 , _:c14n381 , _:c14n383 , _:c14n68 , _:c14n77 ;
	skos:definition "Something the organization does with PII: why, on what basis, what it does to which PII, who is responsible, and how long the PII is kept." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "The fields are what an adopter keeps. The framework's own subject here is what counts as processing, which PfOperation lists." .
iso29100:PfRecordMixin a owl:Class ;
	rdfs:label "PfRecordMixin" ;
	rdfs:subClassOf _:c14n111 , _:c14n24 , _:c14n253 , _:c14n284 , _:c14n340 , _:c14n408 , _:c14n42 , _:c14n95 , _:c14n97 ;
	skos:definition "What every record of the framework has, so that other records can refer to it: an identifier, a title and a description." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "It is a mixin, not a base class, so that the adapt copy can re-root some record classes on LOKF's Concept and leave the others as they are. lokf adapt replaces pf_id with LOKF's id, and a class that declares id itself must descend from Concept." .
iso29100:PfRequirementFactor\#business a owl:Class ;
	rdfs:label "business" ;
	rdfs:subClassOf iso29100:PfRequirementFactor ;
	skos:definition "How the business or its application works, or a code of practice it chose to follow." .
iso29100:PfRequirementFactor\#contract a owl:Class ;
	rdfs:label "contract" ;
	rdfs:subClassOf iso29100:PfRequirementFactor ;
	skos:definition "An agreement between parties, such as one with a processor, or rules that bind a group of companies." .
iso29100:PfRequirementFactor\#law a owl:Class ;
	rdfs:label "law" ;
	rdfs:subClassOf iso29100:PfRequirementFactor ;
	skos:definition "A statute, a regulation, a court's ruling or a collective agreement." .
iso29100:PfRequirementFactor\#other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf iso29100:PfRequirementFactor ;
	skos:definition "Another source, such as what people have said they prefer, or a technical standard the organization adopted." .
iso29100:PfRequirementFactor a owl:Class ;
	rdfs:label "PfRequirementFactor" ;
	owl:unionOf _:c14n160 ;
	skos:definition "Where a requirement to safeguard PII comes from." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfRequirementFactor\#business , iso29100:PfRequirementFactor\#contract , iso29100:PfRequirementFactor\#law , iso29100:PfRequirementFactor\#other ;
	iso29100:iso29100_clause "5.5" .
iso29100:PfRisk a owl:Class ;
	rdfs:label "PfRisk" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n121 , _:c14n134 , _:c14n14 , _:c14n143 , _:c14n144 , _:c14n180 , _:c14n191 , _:c14n254 , _:c14n270 , _:c14n311 , _:c14n321 , _:c14n324 , _:c14n326 , _:c14n33 , _:c14n347 , _:c14n370 , _:c14n376 , _:c14n385 , _:c14n400 , _:c14n406 , _:c14n52 , _:c14n58 , _:c14n63 , _:c14n80 ;
	skos:definition "A way that handling PII could harm people: where the risk comes from, how likely and how bad it is, and what is done about it." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "The framework names privacy risk as an idea and leaves the scale to the organization. These fields are what an adopter keeps." .
iso29100:PfRiskLevel\#high a owl:Class ;
	rdfs:label "high" ;
	rdfs:subClassOf iso29100:PfRiskLevel ;
	skos:definition "The harm could be serious." .
iso29100:PfRiskLevel\#low a owl:Class ;
	rdfs:label "low" ;
	rdfs:subClassOf iso29100:PfRiskLevel ;
	skos:definition "The harm to people would be limited." .
iso29100:PfRiskLevel\#medium a owl:Class ;
	rdfs:label "medium" ;
	rdfs:subClassOf iso29100:PfRiskLevel ;
	skos:definition "The harm would call for planned measures." .
iso29100:PfRiskLevel\#very_high a owl:Class ;
	rdfs:label "very_high" ;
	rdfs:subClassOf iso29100:PfRiskLevel ;
	skos:definition "The harm could be severe or lasting, and needs treating at once." .
iso29100:PfRiskLevel a owl:Class ;
	rdfs:label "PfRiskLevel" ;
	owl:unionOf _:c14n90 ;
	skos:definition "A qualitative level of risk to people, offered for an organization that adopts it, since the framework leaves the scale to the organization." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfRiskLevel\#high , iso29100:PfRiskLevel\#low , iso29100:PfRiskLevel\#medium , iso29100:PfRiskLevel\#very_high .
iso29100:PfSafeguardingRequirement a owl:Class ;
	rdfs:label "PfSafeguardingRequirement" ;
	rdfs:subClassOf iso29100:PfRecordMixin , _:c14n103 , _:c14n133 , _:c14n154 , _:c14n198 , _:c14n221 , _:c14n30 , _:c14n314 , _:c14n319 , _:c14n364 , _:c14n79 ;
	skos:definition "Something the organization must do to protect PII, and where that duty comes from." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.5" .
iso29100:PfSensitivity\#ordinary a owl:Class ;
	rdfs:label "ordinary" ;
	rdfs:subClassOf iso29100:PfSensitivity ;
	skos:definition "It needs the usual protection for PII." .
iso29100:PfSensitivity\#sensitive a owl:Class ;
	rdfs:label "sensitive" ;
	rdfs:subClassOf iso29100:PfSensitivity ;
	skos:definition "Its misuse could badly harm the person, or a law sets it apart, such as health data, so it needs stronger protection." .
iso29100:PfSensitivity a owl:Class ;
	rdfs:label "PfSensitivity" ;
	owl:unionOf _:c14n28 ;
	skos:definition "How much harm the PII could do to the person it is about." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	linkml:permissible_values iso29100:PfSensitivity\#ordinary , iso29100:PfSensitivity\#sensitive ;
	iso29100:iso29100_clause "5.4" .
iso29100:PfThirdParty a owl:Class ;
	rdfs:label "PfThirdParty" ;
	rdfs:subClassOf iso29100:PfActor , _:c14n183 , _:c14n247 , _:c14n298 , _:c14n34 , _:c14n50 , _:c14n74 ;
	skos:definition "A party outside the controller and its processors that receives PII for its own ends, and usually becomes a controller of that PII." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	iso29100:iso29100_clause "5.2" .
iso29100:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the record says or describes, in the organization's own words." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
iso29100:pf_activity_flows a owl:ObjectProperty ;
	rdfs:label "pf_activity_flows" ;
	skos:definition "The flows of PII the activity involves." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_actor_type a owl:DatatypeProperty ;
	rdfs:label "pf_actor_type" ;
	rdfs:range xsd:string ;
	skos:definition "The kind of actor: PfPiiPrincipal, PfPiiController, PfPiiProcessor or PfThirdParty." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_actors a owl:ObjectProperty ;
	rdfs:label "pf_actors" ;
	skos:definition "Those who take part in handling the PII." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_answers_requirements a owl:ObjectProperty ;
	rdfs:label "pf_answers_requirements" ;
	skos:definition "The safeguarding requirements the control answers to." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_applies_to a owl:ObjectProperty ;
	rdfs:label "pf_applies_to" ;
	skos:definition "The actors that must meet it." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_appointed_processors a owl:ObjectProperty ;
	rdfs:label "pf_appointed_processors" ;
	skos:definition "The processors that work for the controller." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_assessed_activities a owl:ObjectProperty ;
	rdfs:label "pf_assessed_activities" ;
	skos:definition "The processing activities it looks at." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_assessment_date a owl:DatatypeProperty ;
	rdfs:label "pf_assessment_date" ;
	skos:definition "When the assessment was done." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_assessment_outcome a owl:DatatypeProperty ;
	rdfs:label "pf_assessment_outcome" ;
	skos:definition "What the assessment concluded." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_assessment_scope a owl:DatatypeProperty ;
	rdfs:label "pf_assessment_scope" ;
	skos:definition "What the assessment looks at." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_assessor a owl:DatatypeProperty ;
	rdfs:label "pf_assessor" ;
	skos:definition "Who did the assessment." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_breach_closed a owl:DatatypeProperty ;
	rdfs:label "pf_breach_closed" ;
	skos:definition "When the organization closed the matter, which is not before it found out." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_breach_discovered a owl:DatatypeProperty ;
	rdfs:label "pf_breach_discovered" ;
	skos:definition "When the organization found out, which is not before it happened." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_breach_occurred a owl:DatatypeProperty ;
	rdfs:label "pf_breach_occurred" ;
	skos:definition "When the breach happened." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_breach_severity a owl:ObjectProperty ;
	rdfs:label "pf_breach_severity" ;
	skos:definition "How serious the breach is." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_breached_requirements a owl:ObjectProperty ;
	rdfs:label "pf_breached_requirements" ;
	skos:definition "The safeguarding requirements the breach went against." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_breaches a owl:ObjectProperty ;
	rdfs:label "pf_breaches" ;
	skos:definition "The breaches the organization has recorded." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_concerned_pii a owl:ObjectProperty ;
	rdfs:label "pf_concerned_pii" ;
	rdfs:range iso29100:PfPiiItem ;
	skos:definition "The PII items the record concerns." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_concerned_principals a owl:ObjectProperty ;
	rdfs:label "pf_concerned_principals" ;
	rdfs:range iso29100:PfPiiPrincipal ;
	skos:definition "The people the PII of the record is about." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_consent_given a owl:DatatypeProperty ;
	rdfs:label "pf_consent_given" ;
	skos:definition "When the person agreed." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_consent_mechanism a owl:ObjectProperty ;
	rdfs:label "pf_consent_mechanism" ;
	skos:definition "How the agreement was obtained." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_consent_state a owl:ObjectProperty ;
	rdfs:label "pf_consent_state" ;
	skos:definition "Where the agreement stands." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_consent_withdrawn a owl:DatatypeProperty ;
	rdfs:label "pf_consent_withdrawn" ;
	skos:definition "When the person took the agreement back." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_consents a owl:ObjectProperty ;
	rdfs:label "pf_consents" ;
	skos:definition "The consents the organization holds." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_consultations a owl:DatatypeProperty ;
	rdfs:label "pf_consultations" ;
	skos:definition "Who was asked, and what they said." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_contact a owl:DatatypeProperty ;
	rdfs:label "pf_contact" ;
	skos:definition "How to reach the actor about privacy." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_control_detail a owl:DatatypeProperty ;
	rdfs:label "pf_control_detail" ;
	skos:definition "How the control is put into effect." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_control_kind a owl:ObjectProperty ;
	rdfs:label "pf_control_kind" ;
	skos:definition "The form the control takes." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_control_objective a owl:DatatypeProperty ;
	rdfs:label "pf_control_objective" ;
	skos:definition "What the control is meant to achieve." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_control_responsible a owl:ObjectProperty ;
	rdfs:label "pf_control_responsible" ;
	skos:definition "The actor that answers for the control." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_control_state a owl:ObjectProperty ;
	rdfs:label "pf_control_state" ;
	skos:definition "How far the control has been put into effect." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_controller a owl:ObjectProperty ;
	rdfs:label "pf_controller" ;
	skos:definition "The controller that answers for the activity." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_controller_policy a owl:ObjectProperty ;
	rdfs:label "pf_controller_policy" ;
	skos:definition "The privacy policy the controller works under." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_controls a owl:ObjectProperty ;
	rdfs:label "pf_controls" ;
	skos:definition "The organization's controls." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_crosses_borders a owl:DatatypeProperty ;
	rdfs:label "pf_crosses_borders" ;
	skos:definition "Whether PII leaves the jurisdiction it was collected in." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_decides_afterwards a owl:ObjectProperty ;
	rdfs:label "pf_decides_afterwards" ;
	skos:definition "The actor that decides what happens to the PII once it has passed. A processor never holds this position." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_evidence a owl:DatatypeProperty ;
	rdfs:label "pf_evidence" ;
	skos:definition "What shows that the record's claim holds, such as a report or a log." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_flows a owl:ObjectProperty ;
	rdfs:label "pf_flows" ;
	skos:definition "The ways PII passes between the actors." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_gaps a owl:DatatypeProperty ;
	rdfs:label "pf_gaps" ;
	skos:definition "Where the organization falls short." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_ict_systems a owl:DatatypeProperty ;
	rdfs:label "pf_ict_systems" ;
	skos:definition "The ICT systems the framework covers." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_id a owl:DatatypeProperty ;
	rdfs:label "pf_id" ;
	rdfs:range _:c14n227 ;
	skos:definition "The record's identifier, unique among the records of the framework, such as a URI or a CURIE. Other records refer to the record by it." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_immediate_actions a owl:DatatypeProperty ;
	rdfs:label "pf_immediate_actions" ;
	skos:definition "What was done straight away." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_impact_assessments a owl:ObjectProperty ;
	rdfs:label "pf_impact_assessments" ;
	skos:definition "The organization's privacy impact assessments." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_improvements a owl:DatatypeProperty ;
	rdfs:label "pf_improvements" ;
	skos:definition "What the organization will do about the gaps." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_inquiry_contact a owl:DatatypeProperty ;
	rdfs:label "pf_inquiry_contact" ;
	skos:definition "Where people can send questions about the policy." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_instructing_controllers a owl:ObjectProperty ;
	rdfs:label "pf_instructing_controllers" ;
	skos:definition "The controllers whose instructions the processor follows." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_jurisdictions a owl:DatatypeProperty ;
	rdfs:label "pf_jurisdictions" ;
	skos:definition "The legal systems that apply to the record, in the organization's terms." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_last_assessed a owl:DatatypeProperty ;
	rdfs:label "pf_last_assessed" ;
	skos:definition "When the organization last checked its standing." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_legal_bases a owl:DatatypeProperty ;
	rdfs:label "pf_legal_bases" ;
	skos:definition "What makes the processing lawful, in the terms of the law that applies." ;
	skos:inScheme <https://w3id.org/lmodel/iso29100> .
iso29100:pf_lessons a owl:DatatypeProperty ;
	rdfs:label "pf_lessons" ;
