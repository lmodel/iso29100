<https://w3id.org/lmodel/iso29100/PfRecordMixin> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	skos:note "It is a mixin, not a base class, so that the adapt copy can re-root some record classes on LOKF's Concept and leave the others as they are. lokf adapt replaces pf_id with LOKF's id, and a class that declares id itself must descend from Concept." ;
	linkml:class_uri "https://w3id.org/lmodel/iso29100/PfRecordMixin"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/PfRecordMixin"^^xsd:anyURI ;
