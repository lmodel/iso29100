	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/iso29100/PfConsent> ;
	linkml:range <https://w3id.org/lmodel/iso29100/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/iso29100/pf_evidence"^^xsd:anyURI .
