	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/pf_principles"^^xsd:anyURI ;
	linkml:description "The privacy principles the record bears on." ;
	linkml:domain_of <https://w3id.org/lmodel/iso29100/PfControl> , <https://w3id.org/lmodel/iso29100/PfPolicy> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/iso29100/PfControl> ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfPrinciple> ;
	linkml:slot_uri "https://w3id.org/lmodel/iso29100/pf_principles"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/pf_privacy_officer> a linkml:SlotDefinition ;
	linkml:description "The person who advises the controller on privacy, where there is one." .
<https://w3id.org/lmodel/iso29100/pf_processing_activities> a linkml:SlotDefinition ;
	linkml:description "What the organization does with PII." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfProcessingActivity> .
<https://w3id.org/lmodel/iso29100/pf_processing_agreement> a linkml:SlotDefinition ;
	linkml:description "The reference of the agreement that binds the processor, where there is one." .
<https://w3id.org/lmodel/iso29100/pf_processors> a linkml:SlotDefinition ;
	linkml:description "The processors that do the work." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfPiiProcessor> .
<https://w3id.org/lmodel/iso29100/pf_provider> a linkml:SlotDefinition ;
	linkml:description "The actor the PII comes from." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfActor> ;
	linkml:required true .
<https://w3id.org/lmodel/iso29100/pf_pseudonymized> a linkml:SlotDefinition ;
	linkml:description "Whether an alias stands in for the item's identifying details." ;
	linkml:range <https://w3id.org/lmodel/iso29100/boolean> .
<https://w3id.org/lmodel/iso29100/pf_purposes> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/pf_purposes"^^xsd:anyURI ;
	linkml:description "The reasons the PII is processed, in the organization's own words." ;
	linkml:domain_of <https://w3id.org/lmodel/iso29100/PfConsent> , <https://w3id.org/lmodel/iso29100/PfPiiController> , <https://w3id.org/lmodel/iso29100/PfPolicy> , <https://w3id.org/lmodel/iso29100/PfProcessingActivity> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/iso29100/PfConsent> ;
	linkml:range <https://w3id.org/lmodel/iso29100/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/iso29100/pf_purposes"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/pf_receiving_purpose> a linkml:SlotDefinition ;
	linkml:description "What the third party receives the PII for." .
<https://w3id.org/lmodel/iso29100/pf_recipient> a linkml:SlotDefinition ;
	linkml:description "The actor the PII goes to." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfActor> ;
	linkml:required true .
<https://w3id.org/lmodel/iso29100/pf_recognized_by> a linkml:SlotDefinition ;
	linkml:description "Why the information counts as PII." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfPiiRecognition> .
<https://w3id.org/lmodel/iso29100/pf_refused_operations> a linkml:SlotDefinition ;
	linkml:description "What the person does not want done to their PII." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfOperation> .
<https://w3id.org/lmodel/iso29100/pf_refused_recipients> a linkml:SlotDefinition ;
	linkml:description "Who the person does not want their PII passed to." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/iso29100/pf_related_controls> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/pf_related_controls"^^xsd:anyURI ;
	linkml:description "The organization's controls that act on the record's subject." ;
	linkml:domain_of <https://w3id.org/lmodel/iso29100/PfPrincipleImplementation> , <https://w3id.org/lmodel/iso29100/PfProcessingActivity> , <https://w3id.org/lmodel/iso29100/PfRisk> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/iso29100/PfRisk> ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfControl> ;
	linkml:slot_uri "https://w3id.org/lmodel/iso29100/pf_related_controls"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/pf_remediation> a linkml:SlotDefinition ;
	linkml:description "What was done to put things right." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/iso29100/pf_requirement_factor> a linkml:SlotDefinition ;
	linkml:description "Where the requirement comes from." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfRequirementFactor> ;
	linkml:required true .
<https://w3id.org/lmodel/iso29100/pf_requirement_source> a linkml:SlotDefinition ;
	linkml:description "The law, contract or other document that states it." .
<https://w3id.org/lmodel/iso29100/pf_retention> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/pf_retention"^^xsd:anyURI ;
	linkml:description "How long the PII is kept, as an ISO 8601 duration." ;
	linkml:domain_of <https://w3id.org/lmodel/iso29100/PfPiiItem> , <https://w3id.org/lmodel/iso29100/PfProcessingActivity> ;
	linkml:owner <https://w3id.org/lmodel/iso29100/PfProcessingActivity> ;
	linkml:range <https://w3id.org/lmodel/iso29100/pf_duration> ;
	linkml:slot_uri "https://w3id.org/lmodel/iso29100/pf_retention"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/pf_retention_statement> a linkml:SlotDefinition ;
	linkml:description "What the policy says about how long PII is kept." .
<https://w3id.org/lmodel/iso29100/pf_risk_consequence> a linkml:SlotDefinition ;
	linkml:description "What the harm to people would be." .
<https://w3id.org/lmodel/iso29100/pf_risk_inherent_level> a linkml:SlotDefinition ;
	linkml:description "The risk's level before controls." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfRiskLevel> .
<https://w3id.org/lmodel/iso29100/pf_risk_likelihood> a linkml:SlotDefinition ;
	linkml:description "How likely the harm is, in the organization's own terms." .
<https://w3id.org/lmodel/iso29100/pf_risk_owner> a linkml:SlotDefinition ;
	linkml:description "The person who answers for the risk." .
<https://w3id.org/lmodel/iso29100/pf_risk_residual_level> a linkml:SlotDefinition ;
	linkml:description "The risk's level after controls, which is never above the level before." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfRiskLevel> .
<https://w3id.org/lmodel/iso29100/pf_risk_source> a linkml:SlotDefinition ;
	linkml:description "Where the risk comes from." .
<https://w3id.org/lmodel/iso29100/pf_risks> a linkml:SlotDefinition ;
	linkml:description "The risks to people that the organization has identified." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfRisk> .
<https://w3id.org/lmodel/iso29100/pf_risks_accepted> a linkml:SlotDefinition ;
	linkml:description "Those of the risks found that the organization has accepted as they stand." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfRisk> .
<https://w3id.org/lmodel/iso29100/pf_risks_found> a linkml:SlotDefinition ;
	linkml:description "The risks it found." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfRisk> .
<https://w3id.org/lmodel/iso29100/pf_risks_treated> a linkml:SlotDefinition ;
	linkml:description "Those of the risks found that have been treated." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfRisk> .
<https://w3id.org/lmodel/iso29100/pf_safeguarding_requirements> a linkml:SlotDefinition ;
	linkml:description "What the organization must do to safeguard PII." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfSafeguardingRequirement> .
<https://w3id.org/lmodel/iso29100/pf_sensitivities> a linkml:SlotDefinition ;
	linkml:description "The levels of sensitivity among the PII involved." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfSensitivity> .
<https://w3id.org/lmodel/iso29100/pf_sensitivity> a linkml:SlotDefinition ;
	linkml:description "How sensitive the item is." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfSensitivity> .
<https://w3id.org/lmodel/iso29100/pf_stated_rights> a linkml:SlotDefinition ;
	linkml:description "The rights the policy tells people they have." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/iso29100/pf_sub_processors> a linkml:SlotDefinition ;
	linkml:description "The processors this processor has engaged in turn." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfPiiProcessor> .
<https://w3id.org/lmodel/iso29100/pf_transfer_basis> a linkml:SlotDefinition ;
	linkml:description "What makes the passing of PII to the third party lawful." .
<https://w3id.org/lmodel/iso29100/pf_transfer_safeguards> a linkml:SlotDefinition ;
	linkml:description "What protects the PII when it crosses a border." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/iso29100/pf_wants_anonymity> a linkml:SlotDefinition ;
	linkml:description "Whether the person asks not to be identified at all." ;
	linkml:range <https://w3id.org/lmodel/iso29100/boolean> .
<https://w3id.org/lmodel/iso29100/pf_wants_pseudonymity> a linkml:SlotDefinition ;
	linkml:description "Whether the person asks to appear under an alias." ;
	linkml:range <https://w3id.org/lmodel/iso29100/boolean> .
<https://w3id.org/lmodel/iso29100/physical> linkml:description "A measure that guards the places and equipment where PII sits." .
<https://w3id.org/lmodel/iso29100/planned> linkml:description "It is decided on but not started." .
<https://w3id.org/lmodel/iso29100/principle_6_10> dcterms:title "6.10 Answer for it" ;
	linkml:annotations _:c14n14 ;
	linkml:description "The organization writes down its duties, keeps protection in place when PII passes to others, and handles complaints and redress." .
<https://w3id.org/lmodel/iso29100/principle_6_11> dcterms:title "6.11 Keep it safe" ;
	linkml:annotations _:c14n7 ;
	linkml:description "Security measures at every level guard PII against loss and unauthorized reach for as long as it is held." .
<https://w3id.org/lmodel/iso29100/principle_6_12> dcterms:title "6.12 Show the rules are met" ;
	linkml:annotations _:c14n42 ;
	linkml:description "The organization checks, and can prove, that it meets its privacy duties, through audits and regular risk assessment." .
<https://w3id.org/lmodel/iso29100/principle_6_2> dcterms:title "6.2 People decide" ;
	linkml:annotations _:c14n30 ;
	linkml:description "People get a say in whether their PII is processed, can agree or refuse purpose by purpose, and can change their minds later." .
<https://w3id.org/lmodel/iso29100/principle_6_3> dcterms:title "6.3 Lawful, stated reasons" ;
	linkml:annotations _:c14n27 ;
	linkml:description "The law allows each reason for processing, and people are told the reason before their PII is gathered, or at that moment." .
<https://w3id.org/lmodel/iso29100/principle_6_4> dcterms:title "6.4 Gather within bounds" ;
	linkml:annotations _:c14n50 ;
	linkml:description "The organization gathers only the PII that the law allows and its stated reasons need." .
<https://w3id.org/lmodel/iso29100/principle_6_5> dcterms:title "6.5 A small footprint" ;
	linkml:annotations _:c14n26 ;
	linkml:description "Systems and procedures are built to touch as little PII as they can, and as few people as possible can reach it." .
<https://w3id.org/lmodel/iso29100/principle_6_6> dcterms:title "6.6 Bounded use and keeping" ;
	linkml:annotations _:c14n6 ;
	linkml:description "PII is used, shared and kept only as far as the stated reasons go, and is safely disposed of afterwards." .
<https://w3id.org/lmodel/iso29100/principle_6_7> dcterms:title "6.7 Correct and fit" ;
	linkml:annotations _:c14n57 ;
	linkml:description "PII stays right, whole, up to date and suited to its use, and there are ways to check and fix it." .
<https://w3id.org/lmodel/iso29100/principle_6_8> dcterms:title "6.8 Say what happens" ;
	linkml:annotations _:c14n20 ;
	linkml:description "People can easily find out what the organization does with PII, and hear about important changes." .
<https://w3id.org/lmodel/iso29100/principle_6_9> dcterms:title "6.9 People see their own" ;
	linkml:annotations _:c14n41 ;
	linkml:description "People can look at the PII held about them and dispute it, within what the law allows." .
<https://w3id.org/lmodel/iso29100/privacy_enhancing_technology> linkml:description "A technical measure built to reduce what is collected or revealed about people." .
<https://w3id.org/lmodel/iso29100/pseudonym> linkml:description "It holds an alias in place of an identifier, and the alias can be traced." .
<https://w3id.org/lmodel/iso29100/pseudonymize> linkml:description "Swap identifying details for an alias, in a way someone can still trace back." .
<https://w3id.org/lmodel/iso29100/public_notice> linkml:description "The people whose PII it handles, who read it to learn what happens." .
<https://w3id.org/lmodel/iso29100/refused> linkml:description "The person said no." .
<https://w3id.org/lmodel/iso29100/retired> linkml:description "It is no longer in use." .
<https://w3id.org/lmodel/iso29100/retrieve> linkml:description "Fetch stored PII for use." .
<https://w3id.org/lmodel/iso29100/sensitive> linkml:description "Its misuse could badly harm the person, or a law sets it apart, such as health data, so it needs stronger protection." .
<https://w3id.org/lmodel/iso29100/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/store> linkml:description "Hold PII on a lasting medium." .
<https://w3id.org/lmodel/iso29100/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/technical> linkml:description "A system, product or service that protects PII." .
<https://w3id.org/lmodel/iso29100/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/title"^^xsd:anyURI ;
	linkml:description "The name the organization gives the record." ;
	linkml:domain_of <https://w3id.org/lmodel/iso29100/PfRecordMixin> ;
	linkml:owner <https://w3id.org/lmodel/iso29100/PfRecordMixin> ;
	linkml:range <https://w3id.org/lmodel/iso29100/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/unsolicited> linkml:description "The organization received it without asking for it." .
<https://w3id.org/lmodel/iso29100/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
	linkml:definition_uri "https://w3id.org/linkml/Uriorcurie"^^xsd:anyURI ;
	linkml:description "a URI or a CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/very_high> linkml:description "The harm could be severe or lasting, and needs treating at once." .
<https://w3id.org/lmodel/iso29100/withdrawn> linkml:description "The person took back an agreement they had given." .
