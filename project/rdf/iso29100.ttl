<https://w3id.org/lmodel/iso29100/pf_decides_afterwards> a linkml:SlotDefinition ;
	linkml:description "The actor that decides what happens to the PII once it has passed. A processor never holds this position." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfActor> .
<https://w3id.org/lmodel/iso29100/pf_duration> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/PfDuration"^^xsd:anyURI ;
	linkml:description "A length of time as ISO 8601 writes it, such as P7Y for seven years or P30D for thirty days." ;
	linkml:pattern "^P(?=[0-9T])([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$" ;
	linkml:typeof <https://w3id.org/lmodel/iso29100/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#duration"^^xsd:anyURI .
<https://w3id.org/lmodel/iso29100/pf_evidence> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/pf_evidence"^^xsd:anyURI ;
	linkml:description "What shows that the record's claim holds, such as a report or a log." ;
