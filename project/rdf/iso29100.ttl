	linkml:mixin true ;
	linkml:slot_usage _:c14n55 ;
	linkml:slots <https://w3id.org/lmodel/iso29100/PfRecordMixin_title> , <https://w3id.org/lmodel/iso29100/description> , <https://w3id.org/lmodel/iso29100/pf_id> .
<https://w3id.org/lmodel/iso29100/PfRecordMixin_title> a linkml:SlotDefinition ;
