	skos:prefLabel "title" ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/title"^^xsd:anyURI ;
	linkml:description "The name the organization gives the record." ;
	linkml:domain <https://w3id.org/lmodel/iso29100/PfRecordMixin> ;
	linkml:domain_of <https://w3id.org/lmodel/iso29100/PfRecordMixin> ;
	linkml:is_a <https://w3id.org/lmodel/iso29100/title> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/iso29100/PfRecordMixin> ;
	linkml:pattern "^\\s*\\S" ;
	linkml:range <https://w3id.org/lmodel/iso29100/string> ;
	linkml:required true ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI ;
	linkml:usage_slot_name "title" .
