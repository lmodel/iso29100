<https://w3id.org/lmodel/iso29100/delete> linkml:description "Remove PII so that it can no longer be reached or used." .
<https://w3id.org/lmodel/iso29100/description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso29100"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/description"^^xsd:anyURI ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." ;
	linkml:definition_uri "https://w3id.org/lmodel/iso29100/description"^^xsd:anyURI ;
	linkml:description "What the record says or describes, in the organization's own words." ;
