	linkml:description "How the agreement was obtained." ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfConsentMechanism> .
<https://w3id.org/lmodel/iso29100/pf_consent_state> a linkml:SlotDefinition ;
	linkml:description "Where the agreement stands." ;
	linkml:equals_string "withdrawn" ;
	linkml:range <https://w3id.org/lmodel/iso29100/PfConsentState> ;
	linkml:required true .
<https://w3id.org/lmodel/iso29100/pf_consent_withdrawn> a linkml:SlotDefinition ;
	linkml:description "When the person took the agreement back." ;
