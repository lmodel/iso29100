# metamodel_version: 1.12.0
# version: 2024
BASE <https://w3id.org/lmodel/iso29100/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX schema1: <http://schema.org/>


<PfDuration> xsd:duration

linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<PfActor>  (
    @<PfPiiController> OR @<PfPiiPrincipal> OR @<PfPiiProcessor> OR @<PfThirdParty>
)

<PfActor_struct> {
    (  $<PfActor_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_actor_type> @linkml:String ;
          <pf_jurisdictions> @linkml:String * ;
          <pf_contact> @linkml:String ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfActor> ]
    )
}

<PfBreach> CLOSED {
    (  $<PfBreach_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_concerned_pii> @<PfPiiItem> * ;
          <pf_breach_occurred> @linkml:Datetime ? ;
          <pf_breach_discovered> @linkml:Datetime ? ;
          <pf_breach_closed> @linkml:Datetime ? ;
          <pf_principals_affected> @linkml:Integer ? ;
          <pf_breached_requirements> @<PfSafeguardingRequirement> * ;
          <pf_breach_severity> [ <https://w3id.org/lmodel/iso29100/PfRiskLevel#low>
             <https://w3id.org/lmodel/iso29100/PfRiskLevel#medium> <https://w3id.org/lmodel/iso29100/PfRiskLevel#high>
             <https://w3id.org/lmodel/iso29100/PfRiskLevel#very_high> ] ? ;
          <pf_immediate_actions> @linkml:String * ;
          <pf_notification_required> @linkml:Boolean ? ;
          <pf_notifications> @linkml:String * ;
          <pf_remediation> @linkml:String * ;
          <pf_lessons> @linkml:String ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfBreach> ]
    )
}

<PfConsent> CLOSED {
    (  $<PfConsent_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_purposes> @linkml:String * ;
          <pf_concerned_pii> @<PfPiiItem> * ;
          <pf_evidence> @linkml:String * ;
          <pf_principal> @<PfPiiPrincipal> ;
          <pf_consent_mechanism> [ <https://w3id.org/lmodel/iso29100/PfConsentMechanism#opt_in>
             <https://w3id.org/lmodel/iso29100/PfConsentMechanism#opt_out>
             <https://w3id.org/lmodel/iso29100/PfConsentMechanism#implied> ] ? ;
          <pf_consent_given> @linkml:Datetime ? ;
          <pf_consent_state> [ <https://w3id.org/lmodel/iso29100/PfConsentState#given>
             <https://w3id.org/lmodel/iso29100/PfConsentState#refused> <https://w3id.org/lmodel/iso29100/PfConsentState#withdrawn>
             <https://w3id.org/lmodel/iso29100/PfConsentState#expired> ] ;
          <pf_consent_withdrawn> @linkml:Datetime ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfConsent> ]
    )
}

<PfControl> CLOSED {
    (  $<PfControl_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_principles> [ <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_2>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_3>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_4>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_5>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_6>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_7>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_8>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_9>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_10>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_11>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_12> ] * ;
          <pf_evidence> @linkml:String * ;
          <pf_control_kind> [ <https://w3id.org/lmodel/iso29100/PfControlKind#organizational>
             <https://w3id.org/lmodel/iso29100/PfControlKind#physical> <https://w3id.org/lmodel/iso29100/PfControlKind#technical>
             <https://w3id.org/lmodel/iso29100/PfControlKind#privacy_enhancing_technology>
             <https://w3id.org/lmodel/iso29100/PfControlKind#contractual> ] ;
          <pf_control_objective> @linkml:String ? ;
          <pf_control_detail> @linkml:String ? ;
          <pf_control_responsible> @<PfActor> ? ;
          <pf_control_state> [ <https://w3id.org/lmodel/iso29100/PfImplementationState#planned>
             <https://w3id.org/lmodel/iso29100/PfImplementationState#in_progress>
             <https://w3id.org/lmodel/iso29100/PfImplementationState#in_operation>
             <https://w3id.org/lmodel/iso29100/PfImplementationState#retired> ] ? ;
          <pf_answers_requirements> @<PfSafeguardingRequirement> * ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfControl> ]
    )
}

<PfFramework> CLOSED {
    (  $<PfFramework_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_jurisdictions> @linkml:String * ;
          <pf_organization> @linkml:String ;
          <pf_ict_systems> @linkml:String * ;
          <pf_actors> @<PfActor> * ;
          <pf_pii_items> @<PfPiiItem> * ;
          <pf_flows> @<PfPiiFlow> * ;
          <pf_processing_activities> @<PfProcessingActivity> * ;
          <pf_safeguarding_requirements> @<PfSafeguardingRequirement> * ;
          <pf_policies> @<PfPolicy> * ;
          <pf_controls> @<PfControl> * ;
          <pf_principle_implementations> @<PfPrincipleImplementation> * ;
          <pf_risks> @<PfRisk> * ;
          <pf_impact_assessments> @<PfImpactAssessment> * ;
          <pf_breaches> @<PfBreach> * ;
          <pf_consents> @<PfConsent> * ;
          <pf_preferences> @<PfPreference> * ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfFramework> ]
    )
}

<PfImpactAssessment> CLOSED {
    (  $<PfImpactAssessment_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_assessment_scope> @linkml:String ? ;
          <pf_assessment_date> @linkml:Date ? ;
          <pf_assessor> @linkml:String ? ;
          <pf_assessed_activities> @<PfProcessingActivity> * ;
          <pf_risks_found> @<PfRisk> * ;
          <pf_risks_treated> @<PfRisk> * ;
          <pf_risks_accepted> @<PfRisk> * ;
          <pf_assessment_outcome> @linkml:String ? ;
          <pf_consultations> @linkml:String * ;
          <pf_next_assessment> @linkml:Date ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfImpactAssessment> ]
    )
}

<PfPiiController> CLOSED {
    (  $<PfPiiController_tes> (  &<PfActor_tes> ;
          rdf:type [ <PfActor> ] ? ;
          <pf_purposes> @linkml:String * ;
          <pf_legal_bases> @linkml:String * ;
          <pf_appointed_processors> @<PfPiiProcessor> * ;
          <pf_controller_policy> @<PfPolicy> ? ;
          <pf_privacy_officer> @linkml:String ?
       ) ;
       rdf:type [ <PfPiiController> ]
    )
}

<PfPiiFlow> CLOSED {
    (  $<PfPiiFlow_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_concerned_pii> @<PfPiiItem> * ;
          <pf_provider> @<PfActor> ;
          <pf_recipient> @<PfActor> ;
          <pf_decides_afterwards> @<PfActor> ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfPiiFlow> ]
    )
}

<PfPiiItem> CLOSED {
    (  $<PfPiiItem_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_concerned_principals> @<PfPiiPrincipal> * ;
          <pf_operations> [ <https://w3id.org/lmodel/iso29100/PfOperation#collect>
             <https://w3id.org/lmodel/iso29100/PfOperation#store> <https://w3id.org/lmodel/iso29100/PfOperation#retrieve>
             <https://w3id.org/lmodel/iso29100/PfOperation#consult> <https://w3id.org/lmodel/iso29100/PfOperation#alter>
             <https://w3id.org/lmodel/iso29100/PfOperation#pseudonymize> <https://w3id.org/lmodel/iso29100/PfOperation#anonymize>
             <https://w3id.org/lmodel/iso29100/PfOperation#disclose> <https://w3id.org/lmodel/iso29100/PfOperation#disseminate>
             <https://w3id.org/lmodel/iso29100/PfOperation#delete> <https://w3id.org/lmodel/iso29100/PfOperation#destroy> ] * ;
          <pf_retention> @<PfDuration> ? ;
          <pf_pii_categories> @linkml:String * ;
          <pf_recognized_by> [ <https://w3id.org/lmodel/iso29100/PfPiiRecognition#direct_identifier>
             <https://w3id.org/lmodel/iso29100/PfPiiRecognition#distinguishing_trait>
             <https://w3id.org/lmodel/iso29100/PfPiiRecognition#linked_information>
             <https://w3id.org/lmodel/iso29100/PfPiiRecognition#pseudonym>
             <https://w3id.org/lmodel/iso29100/PfPiiRecognition#metadata>
             <https://w3id.org/lmodel/iso29100/PfPiiRecognition#unsolicited> ] * ;
          <pf_sensitivity> [ <https://w3id.org/lmodel/iso29100/PfSensitivity#ordinary>
             <https://w3id.org/lmodel/iso29100/PfSensitivity#sensitive> ] ? ;
          <pf_pseudonymized> @linkml:Boolean ? ;
          <pf_linkability> @linkml:String ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfPiiItem> ]
    )
}

<PfPiiPrincipal> CLOSED {
    (  $<PfPiiPrincipal_tes> (  &<PfActor_tes> ;
          rdf:type [ <PfActor> ] ?
       ) ;
       rdf:type [ <PfPiiPrincipal> ]
    )
}

<PfPiiProcessor> CLOSED {
    (  $<PfPiiProcessor_tes> (  &<PfActor_tes> ;
          rdf:type [ <PfActor> ] ? ;
          <pf_instructing_controllers> @<PfPiiController> * ;
          <pf_processing_agreement> @linkml:String ? ;
          <pf_sub_processors> @<PfPiiProcessor> *
       ) ;
       rdf:type [ <PfPiiProcessor> ]
    )
}

<PfPolicy> CLOSED {
    (  $<PfPolicy_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_purposes> @linkml:String * ;
          <pf_concerned_pii> @<PfPiiItem> * ;
          <pf_principles> [ <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_2>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_3>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_4>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_5>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_6>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_7>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_8>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_9>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_10>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_11>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_12> ] * ;
          <pf_policy_audience> [ <https://w3id.org/lmodel/iso29100/PfPolicyAudience#internal>
             <https://w3id.org/lmodel/iso29100/PfPolicyAudience#public_notice> ] ;
          <pf_policy_version> @linkml:String ? ;
          <pf_policy_scope> @linkml:String ? ;
          <pf_policy_effective_date> @linkml:Date ? ;
          <pf_policy_last_reviewed> @linkml:Date ? ;
          <pf_retention_statement> @linkml:String ? ;
          <pf_stated_rights> @linkml:String * ;
          <pf_inquiry_contact> @linkml:String ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfPolicy> ]
    )
}

<PfPreference> CLOSED {
    (  $<PfPreference_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_principal> @<PfPiiPrincipal> ;
          <pf_preference_scope> @linkml:String ? ;
          <pf_wants_anonymity> @linkml:Boolean ? ;
          <pf_wants_pseudonymity> @linkml:Boolean ? ;
          <pf_refused_operations> [ <https://w3id.org/lmodel/iso29100/PfOperation#collect>
             <https://w3id.org/lmodel/iso29100/PfOperation#store> <https://w3id.org/lmodel/iso29100/PfOperation#retrieve>
             <https://w3id.org/lmodel/iso29100/PfOperation#consult> <https://w3id.org/lmodel/iso29100/PfOperation#alter>
             <https://w3id.org/lmodel/iso29100/PfOperation#pseudonymize> <https://w3id.org/lmodel/iso29100/PfOperation#anonymize>
             <https://w3id.org/lmodel/iso29100/PfOperation#disclose> <https://w3id.org/lmodel/iso29100/PfOperation#disseminate>
             <https://w3id.org/lmodel/iso29100/PfOperation#delete> <https://w3id.org/lmodel/iso29100/PfOperation#destroy> ] * ;
          <pf_refused_recipients> @linkml:String * ;
          <pf_preference_recorded> @linkml:Date ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfPreference> ]
    )
}

<PfPrincipleImplementation> CLOSED {
    (  $<PfPrincipleImplementation_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_related_controls> @<PfControl> * ;
          <pf_evidence> @linkml:String * ;
          <pf_principle> [ <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_2>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_3>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_4>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_5>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_6>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_7>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_8>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_9>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_10>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_11>
             <https://w3id.org/lmodel/iso29100/PfPrinciple#principle_6_12> ] ;
          <pf_measures> @linkml:String * ;
          <pf_gaps> @linkml:String * ;
          <pf_improvements> @linkml:String * ;
          <pf_last_assessed> @linkml:Date ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfPrincipleImplementation> ]
    )
}

<PfProcessingActivity> CLOSED {
    (  $<PfProcessingActivity_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_purposes> @linkml:String * ;
          <pf_legal_bases> @linkml:String * ;
          <pf_operations> [ <https://w3id.org/lmodel/iso29100/PfOperation#collect>
             <https://w3id.org/lmodel/iso29100/PfOperation#store> <https://w3id.org/lmodel/iso29100/PfOperation#retrieve>
             <https://w3id.org/lmodel/iso29100/PfOperation#consult> <https://w3id.org/lmodel/iso29100/PfOperation#alter>
             <https://w3id.org/lmodel/iso29100/PfOperation#pseudonymize> <https://w3id.org/lmodel/iso29100/PfOperation#anonymize>
             <https://w3id.org/lmodel/iso29100/PfOperation#disclose> <https://w3id.org/lmodel/iso29100/PfOperation#disseminate>
             <https://w3id.org/lmodel/iso29100/PfOperation#delete> <https://w3id.org/lmodel/iso29100/PfOperation#destroy> ] * ;
          <pf_concerned_pii> @<PfPiiItem> * ;
          <pf_retention> @<PfDuration> ? ;
          <pf_related_controls> @<PfControl> * ;
          <pf_controller> @<PfPiiController> ;
          <pf_processors> @<PfPiiProcessor> * ;
          <pf_activity_flows> @<PfPiiFlow> * ;
          <pf_sensitivities> [ <https://w3id.org/lmodel/iso29100/PfSensitivity#ordinary>
             <https://w3id.org/lmodel/iso29100/PfSensitivity#sensitive> ] * ;
          <pf_crosses_borders> @linkml:Boolean ? ;
          <pf_transfer_safeguards> @linkml:String * ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfProcessingActivity> ]
    )
}

<PfRecordMixin> {
    (  $<PfRecordMixin_tes> (  schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfRecordMixin> ]
    )
}

<PfRisk> CLOSED {
    (  $<PfRisk_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_concerned_pii> @<PfPiiItem> * ;
          <pf_concerned_principals> @<PfPiiPrincipal> * ;
          <pf_related_controls> @<PfControl> * ;
          <pf_risk_source> @linkml:String ? ;
          <pf_risk_likelihood> @linkml:String ? ;
          <pf_risk_consequence> @linkml:String ? ;
          <pf_risk_inherent_level> [ <https://w3id.org/lmodel/iso29100/PfRiskLevel#low>
             <https://w3id.org/lmodel/iso29100/PfRiskLevel#medium> <https://w3id.org/lmodel/iso29100/PfRiskLevel#high>
             <https://w3id.org/lmodel/iso29100/PfRiskLevel#very_high> ] ? ;
          <pf_risk_residual_level> [ <https://w3id.org/lmodel/iso29100/PfRiskLevel#low>
             <https://w3id.org/lmodel/iso29100/PfRiskLevel#medium> <https://w3id.org/lmodel/iso29100/PfRiskLevel#high>
             <https://w3id.org/lmodel/iso29100/PfRiskLevel#very_high> ] ? ;
          <pf_risk_owner> @linkml:String ? ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfRisk> ]
    )
}

<PfSafeguardingRequirement> CLOSED {
    (  $<PfSafeguardingRequirement_tes> (  &<PfRecordMixin_tes> ;
          rdf:type [ <PfRecordMixin> ] ? ;
          <pf_requirement_factor> [ <https://w3id.org/lmodel/iso29100/PfRequirementFactor#law>
             <https://w3id.org/lmodel/iso29100/PfRequirementFactor#contract>
             <https://w3id.org/lmodel/iso29100/PfRequirementFactor#business>
             <https://w3id.org/lmodel/iso29100/PfRequirementFactor#other> ] ;
          <pf_requirement_source> @linkml:String ? ;
          <pf_applies_to> @<PfActor> * ;
          <pf_met_by> @<PfControl> * ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ <PfSafeguardingRequirement> ]
    )
}

<PfThirdParty> CLOSED {
    (  $<PfThirdParty_tes> (  &<PfActor_tes> ;
          rdf:type [ <PfActor> ] ? ;
          <pf_receiving_purpose> @linkml:String ? ;
          <pf_transfer_basis> @linkml:String ?
       ) ;
       rdf:type [ <PfThirdParty> ]
    )
}
